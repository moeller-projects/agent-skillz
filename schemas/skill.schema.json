{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skillz.local/schemas/skill.schema.json",
  "title": "Skill package",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "files"],
  "properties": {
    "metadata": {
      "$ref": "./metadata.schema.json"
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "required": ["skill", "readme", "metadata"]
    }
  }
}

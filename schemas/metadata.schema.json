{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skillz.local/schemas/metadata.schema.json",
  "title": "Skill metadata",
  "type": "object",
  "required": ["name", "title", "version", "summary", "type", "activation"],
  "additionalProperties": true,
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "enum": ["prompt", "rule", "script", "hybrid"]
    },
    "activation": {
      "type": "object",
      "required": ["use_when", "avoid_when"],
      "properties": {
        "use_when": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "avoid_when": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "compatibility": {
      "type": "array",
      "items": { "type": "string" }
    },
    "risk_level": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "requires_network": {
      "type": "boolean"
    },
    "maintainer": {
      "type": "string"
    }
  }
}

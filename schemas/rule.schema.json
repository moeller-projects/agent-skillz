{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-skillz.local/schemas/rule.schema.json",
  "title": "Skill rule",
  "type": "object",
  "required": ["text", "impact"],
  "additionalProperties": false,
  "properties": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "impact": {
      "type": "string",
      "enum": ["critical", "high", "medium", "low"]
    }
  }
}

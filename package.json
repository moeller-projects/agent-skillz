{
  "name": "agent-skillz",
  "private": true,
  "type": "module",
  "scripts": {
    "validate": "bun run --cwd packages/skill-build validate && bash scripts/check-skill-output-contracts.sh",
    "validate:outputs": "bash scripts/check-skill-output-contracts.sh",
    "build": "bun run --cwd packages/skill-build build",
    "pack": "bun run --cwd packages/skill-build pack",
    "version:check": "bun run --cwd packages/skill-build version:check",
    "version:apply": "bun run --cwd packages/skill-build version:apply",
    "dev": "bun run validate && bun run build && bun run pack"
  },
  "devDependencies": {
    "@types/bun": "1.3.13",
    "typescript": "6.0.3"
  }
}

{
  "name": "caveman",
  "title": "Caveman Mode",
  "version": "0.1.0",
  "summary": "Ultra-concise high-signal responses with aggressive token minimization.",
  "type": "prompt",
  "activation": {
    "use_when": [
      "Token saving is critical",
      "User wants ultra concise output"
    ],
    "avoid_when": [
      "Detailed reasoning is required",
      "Nuanced explanation is needed"
    ]
  },
  "compatibility": ["chatgpt", "codex", "claude-code", "cursor", "opencode"],
  "risk_level": "low",
  "requires_network": false,
  "maintainer": "Lukas"
}
